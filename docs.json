{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GasPro Help Centre",
  "colors": {
    "primary": "#012F87",
    "light": "#233DFF",
    "dark": "#011F5C"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": ["index", "dashboard"]
      },
      {
        "group": "Everyday work",
        "pages": ["customers", "job-addresses", "jobs", "calendar"]
      },
      {
        "group": "Certificates",
        "pages": [
          "certificates/index",
          "certificates/homeowner-walkthrough",
          "certificates/types",
          "certificates/send"
        ]
      },
      {
        "group": "Billing",
        "pages": ["invoices-quotes-estimates"]
      },
      {
        "group": "Tools",
        "pages": ["boiler-manuals", "calculators", "importing", "gaspro-ai"]
      },
      {
        "group": "Account",
        "pages": ["team", "settings", "subscription", "quickbooks"]
      },
      {
        "group": "Help",
        "pages": ["troubleshooting"]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GasPro website",
          "href": "https://www.gasproapp.co.uk",
          "icon": "globe"
        },
        {
          "anchor": "Support",
          "href": "https://www.gasproapp.co.uk/contact",
          "icon": "envelope"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://www.gasproapp.co.uk/contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open GasPro",
      "href": "https://app.gasproapp.co.uk"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
